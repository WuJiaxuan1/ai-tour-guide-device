{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端：附加到本地服务 9230",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9230,
      "skipFiles": ["<node_internals>/**"],
      "restart": true
    },
    {
      "name": "前端：Chrome 调试本地网页",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5174/",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    }
  ]
}
