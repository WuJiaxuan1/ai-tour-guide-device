AMAP_WEB_KEY=
AMAP_SECURITY_JSCODE=
AMAP_SERVER_KEY=

# Text generation: server only. DeepSeek official keys do not work at JD Cloud.
TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Alternative: TEXT_PROVIDER=jdcloud
JDCLOUD_API_KEY=
JDCLOUD_MODEL=DeepSeek-V4.1-Flash-1017

# Inactive legacy image provider fields. photo-r12 disables new photo creation.
QIXIA_IMAGE_ENDPOINT=
QIXIA_IMAGE_API_KEY=

# Server-to-MCP bridge identity; use the same private value in the MCP service environment.
QIXIA_MCP_SECRET=
MCP_ENDPOINT=
QIXIA_API_BASE=http://127.0.0.1:8787
