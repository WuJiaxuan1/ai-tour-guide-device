# Include inside an existing HTTPS server {} with a trusted matching certificate.
# Proxy the complete site, including /api/ and /_AMapService/.
location / {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 3600s;
    client_max_body_size 128k;
}
