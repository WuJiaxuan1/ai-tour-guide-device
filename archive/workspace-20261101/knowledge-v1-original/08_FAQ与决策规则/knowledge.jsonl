{"id":"rule_ugc_language","library_id":"KB08","knowledge_type":"decision_rule","name":"UGC表达规则","content":"UGC和画像内容只能使用“有游客反馈”“高峰期可能”“建议”等表达，不能改写为景区客观事实。","source_type":"governance_rule","source_name":"用户提供的栖霞山知识材料","captured_at":"2026-10-27","valid_from":null,"valid_until":null,"verification_status":"approved_internal_rule","confidence":"high","freshness":"static","aliases":[],"audience":["全部游客"],"related_pois":[],"warnings":[],"tags":[],"updated_at":"2026-10-27"}
