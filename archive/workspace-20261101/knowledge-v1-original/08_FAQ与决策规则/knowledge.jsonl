{"id":"rule_source_priority","library_id":"KB08","knowledge_type":"decision_rule","name":"来源优先级","content":"同一事实冲突时按以下顺序处理：当日官方公告或现场公示 > 官方小程序或官方账号快照 > 权威文献 > 地图平台 > 多源UGC > 单条UGC或AI二次整理。冲突未消解时不做确定回答。","source_type":"governance_rule","source_name":"用户提供的栖霞山知识材料","captured_at":"2026-10-27","valid_from":null,"valid_until":null,"verification_status":"approved_internal_rule","confidence":"high","freshness":"static","aliases":[],"audience":["全部游客"],"related_pois":[],"warnings":[],"tags":[],"updated_at":"2026-10-27"}
