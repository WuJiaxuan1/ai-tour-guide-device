{
  "name": "qixia-frontend",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/optimize-images.mjs",
    "build": "node ../backend/scripts/sync-knowledge.mjs && node scripts/optimize-images.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "sync:routes": "node ../backend/scripts/sync-routes.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "1.0.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^1.63.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
