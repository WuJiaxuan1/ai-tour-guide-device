# Public URLs and browser JS API key only; all VITE_* values are visible in the browser.
# Leave unset until the real team services are available.
VITE_AGENT_CHAT_URL=
VITE_AMAP_KEY=
# Same-origin proxy with the securityJsCode added by the team server.
# Example: /_AMapService (see docs/architecture/navigation-integration.md)
VITE_AMAP_SERVICE_HOST=
VITE_NAVIGATION_PLACES_URL=
VITE_ROUTE_PLAN_URL=
